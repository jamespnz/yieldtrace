{
  "name": "solanalytica-mvp",
  "version": "1.0.0",
  "main": "server/server.js",
  "scripts": {
    "build-css": "npx tailwindcss -i ./src/styles/input.css -o ./src/styles/output.css --watch",
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "seed": "node server/utils/seed-data.js",
    "dev:server": "node server/server.js",
    "dev:css": "npx @tailwindcss/cli -i ./src/styles/input.css -o ./src/styles/output.css --watch",
    "studio": "concurrently \"npm run dev:server\" \"npm run dev:css\""
  },
  "dependencies": {
    "@google/genai": "^1.38.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.110.1",
    "@tailwindcss/cli": "^4.1.18",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.23",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18"
  }
}
